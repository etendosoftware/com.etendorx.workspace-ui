{
  "name": "com.etendoerp.ui.playwright-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pw:run": "playwright test",
    "pw:run:smoke": "playwright test --grep @smoke",
    "pw:ui": "playwright test --ui",
    "pw:report": "playwright show-report",
    "pw:one": "playwright test --no-deps",
    "typecheck": "tsc --noEmit",
    "check:e2e": "node scripts/check-e2e.mjs",
    "test:tooling": "node --test scripts/__tests__/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^22.7.8",
    "typescript": "^5.2.2"
  }
}
